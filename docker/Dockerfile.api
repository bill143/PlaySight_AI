# PlaySight AI - FastAPI service image (core deps only, no [cv] extra).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for better layer caching.
COPY pyproject.toml ./
COPY src ./src
RUN pip install --upgrade pip && pip install ".[dev]"

COPY configs ./configs
COPY alembic.ini ./

RUN mkdir -p /app/outputs/storage /app/data

EXPOSE 8000

# Render injects PORT for Docker web services; fall back to 8000 locally.
CMD ["sh", "-c", "uvicorn playsight.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
