# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=PlaySight AI
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=******localhost:5432/playsight

# ------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------
# Object storage (MinIO / S3-compatible)
# ------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=playsight
S3_REGION=us-east-1
S3_USE_SSL=false

# ------------------------------------------------------------
# JWT authentication
# ------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# YouTube publishing
# ------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/publish/youtube/callback
ENABLE_YOUTUBE_UPLOAD=true

# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------
ENABLE_COMPETITION_DATA=false
ENABLE_MERCHANDISE=false
ENABLE_PLAYBOOK=false
ENABLE_TRAINING=false
ENABLE_NUTRITION=false
ENABLE_REGISTRATION=false

# ------------------------------------------------------------
# ML pipeline
# ------------------------------------------------------------
YOLO_MODEL_PATH=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
TRACKER_MAX_AGE=30
OUTPUT_DIR=data/outputs

# ------------------------------------------------------------
# Frontend / API integration
# ------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
