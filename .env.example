# PlaySight AI - environment variables (copy to `.env` and adjust).
# All variables use the PLAYSIGHT_ prefix; nested settings use `__` as delimiter.
# Precedence: environment variables > .env > configs/default.yaml > code defaults.

# Path to the YAML config layer (optional).
#PLAYSIGHT_CONFIG=configs/default.yaml

# Runtime environment: dev | test | prod
PLAYSIGHT_ENV=dev

# SQLAlchemy database URL.
# Local dev (SQLite):
PLAYSIGHT_DATABASE_URL=sqlite:///./playsight.db
# Docker-compose (Postgres):
#PLAYSIGHT_DATABASE_URL=postgresql+psycopg2://playsight:playsight@localhost:5432/playsight

# Redis URL (Celery broker + result backend). Leave EMPTY to run jobs eagerly in-process.
PLAYSIGHT_REDIS_URL=redis://localhost:6379/0

# Force eager (synchronous, in-process) job execution even when redis is configured.
#PLAYSIGHT_EAGER_JOBS=1

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Backend: local | s3 (MinIO is `s3` with an endpoint override).
PLAYSIGHT_STORAGE__BACKEND=local
# Root directory for the `local` backend.
PLAYSIGHT_STORAGE__LOCAL_ROOT=./outputs/storage
# s3/MinIO connection (defaults match the docker-compose MinIO service).
PLAYSIGHT_STORAGE__S3_ENDPOINT=http://localhost:9000
PLAYSIGHT_STORAGE__S3_BUCKET=playsight
PLAYSIGHT_STORAGE__S3_ACCESS_KEY=minioadmin
PLAYSIGHT_STORAGE__S3_SECRET_KEY=minioadmin
PLAYSIGHT_STORAGE__S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Auth (JWT HS256)
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLAYSIGHT_AUTH__SECRET_KEY=dev-only-insecure-secret-change-me
# Access-token lifetime in minutes.
PLAYSIGHT_AUTH__ACCESS_TTL_MINUTES=30
# Refresh-token lifetime in days.
PLAYSIGHT_AUTH__REFRESH_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Vision pipeline
# ---------------------------------------------------------------------------
# Minimum person-detection confidence (0-1).
PLAYSIGHT_PIPELINE__DETECTION_CONF=0.35
# Process every Nth frame.
PLAYSIGHT_PIPELINE__FRAME_STRIDE=2
# Optional cap on frames processed (smoke runs); unset = no cap.
#PLAYSIGHT_PIPELINE__MAX_FRAMES=500

# ---------------------------------------------------------------------------
# YouTube integration (OAuth2 installed-app flow)
# ---------------------------------------------------------------------------
PLAYSIGHT_YOUTUBE__CLIENT_SECRETS_FILE=configs/google_client_secret.json
PLAYSIGHT_YOUTUBE__TOKEN_FILE=configs/youtube_token.json

# ---------------------------------------------------------------------------
# Feature flags (JSON dict; merged over defaults). Per-club overrides live in
# the club_modules table. Defaults: video_analytics/publishing_youtube = true,
# all Phase 2/3 modules = false.
# ---------------------------------------------------------------------------
#PLAYSIGHT_FEATURES={"video_analytics": true, "publishing_youtube": true, "playbook": false}

# ---------------------------------------------------------------------------
# Dashboard (Next.js) - consumed by the dashboard, not the Python package.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
